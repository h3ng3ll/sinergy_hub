#ifdef GL_ES
precision mediump float;
#endif

uniform float u_time;       // время в секундах
uniform vec2 u_resolution;  // размер окна

// функция градиента
vec3 palette(float t) {
    return vec3(
    0.5 + 0.5 * cos(6.2831 * (t + 0.0)),
    0.5 + 0.5 * cos(6.2831 * (t + 0.33)),
    0.5 + 0.5 * cos(6.2831 * (t + 0.67))
    );
}

void main() {
    vec2 uv = (gl_FragCoord.xy - 0.5 * u_resolution.xy) / u_resolution.y;

    // динамические координаты
    float t = u_time * 0.2;

    // создаем волновой паттерн
    float len = length(uv);
    float angle = atan(uv.y, uv.x);

    float wave = sin(10.0 * len - t * 4.0) + cos(6.0 * angle - t * 2.0);

    // цвет по палитре
    vec3 color = palette(wave * 0.05 + t * 0.1);

    // усиливаем фиолетово-синий оттенок
    color = mix(vec3(0.3, 0.2, 0.6), vec3(0.2, 0.4, 0.9), color.b) + 0.2;

    gl_FragColor = vec4(color, 1.0);
}